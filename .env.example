# SecureCaseVault — environment template
# Copy to .env and adjust. Only DATABASE_URL is required for local development.

# PostgreSQL connection string (the app's database)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Document encryption (optional for local development) -------------------
# AES-256-GCM key, 64 hex characters (32 bytes). Generate one with:
#   node scripts/generate-key.mjs
# If not set, the app persists a development key at data/dev-encryption.key
# (fine for local/demo use — set the env var explicitly for deployments).
# SCV_ENCRYPTION_KEY=

# --- Session cookie transport override (optional) ----------------------------
# The hosted (Arena) preview sits behind an HTTPS proxy, so the app uses
# Secure + SameSite=None cookies in production by default. If you run
# `npm run start` (production mode) over plain http://localhost, add:
# SCV_LOCAL_HTTP=true
# (`npm run dev` already uses http-appropriate cookies automatically.)
# SCV_LOCAL_HTTP=true

# --- External AI provider (optional — Step 8) --------------------------------
# Leave unset to use the local rule-based "Prototype Analysis" fallback.
# When all three are set, analysis is sent to this OpenAI-compatible API.
# Keys live ONLY in environment variables — never in code or the database.
# SCV_AI_API_BASE=https://api.openai.com/v1
# SCV_AI_API_KEY=
# SCV_AI_MODEL=gpt-4o-mini
